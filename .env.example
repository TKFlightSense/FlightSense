# ===================================
# LLM Configuration - Classifier
# ===================================
# Provider: "openai" or "vllm"
LLM_PROVIDER=openai

# Model to use (overrides config file defaults)
LLM_MODEL=gpt-4o-mini

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
# Optional: Custom base URL for OpenAI-compatible APIs
# OPENAI_BASE_URL=https://api.openai.com/v1


# ===================================
# LLM Configuration - Agents
# ===================================
# Provider for agents: "openai" or "vllm"
AGENT_LLM_PROVIDER=openai

# Model for agents (overrides config file defaults)
AGENT_LLM_MODEL=gpt-4o-mini

# OpenAI API Configuration for Agents
AGENT_OPENAI_API_KEY=your_openai_api_key_here
# Optional: Custom base URL for agents
# AGENT_OPENAI_BASE_URL=https://api.openai.com/v1


# ===================================
# Email Configuration
# ===================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
SMTP_FROM=reports@airline.com


# ===================================
# Jira Configuration
# ===================================
# Set to "true" to use real Jira, "false" for mock tickets in local DB
USE_REAL_JIRA=true

# Real Jira credentials (required if USE_REAL_JIRA=true)
JIRA_URL=https://tkflightsense.atlassian.net
JIRA_USER=your_jira_email@example.com
JIRA_TOKEN=your_jira_api_token_here


# ===================================
# Database Configuration
# ===================================
# Set to "true" to use MySQL, "false" for SQLite (default)
USE_MYSQL=false

# MySQL Configuration (required if USE_MYSQL=true)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=flightsense
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# SQLite database path (used if USE_MYSQL=false)
DATABASE_PATH=data/flightsense.db


# ===================================
# API Configuration
# ===================================
# Environment: "development" or "production"
ENV=development

# JWT Secret for authentication
JWT_SECRET=your_secure_random_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Server configuration
API_HOST=0.0.0.0
API_PORT=8000

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
